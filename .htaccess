Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Protect projects accidentally served above Laravel's public directory.
    RewriteRule ^(?:\.|app(?:/|$)|bootstrap(?:/|$)|config(?:/|$)|database(?:/|$)|node_modules(?:/|$)|resources(?:/|$)|routes(?:/|$)|storage(?:/|$)|tests(?:/|$)|vendor(?:/|$)|artisan$|.*\.(?:json|lock|md|xml|log|sql|bak)$) - [F,L,NC]
    RewriteRule ^(?!public(?:/|$))(.*)$ public/$1 [L]
</IfModule>
