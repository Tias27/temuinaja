{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format:assets": "prettier --write \"resources/**/*.{css,js}\" \"*.{js,json}\" \".prettierrc.json\" \".bladeformatterrc.json\" README.md",
        "format:blade": "blade-formatter --write \"resources/views/**/*.blade.php\"",
        "format": "npm run format:assets && npm run format:blade",
        "format:check": "prettier --check \"resources/**/*.{css,js}\" \"*.{js,json}\" \".prettierrc.json\" \".bladeformatterrc.json\" README.md && blade-formatter --check-formatted \"resources/views/**/*.blade.php\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "blade-formatter": "1.44.6",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "3.9.10",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "three": "^0.186.1"
    },
    "overrides": {
        "glob": "14.0.4",
        "minimatch": "11.0.7"
    }
}
